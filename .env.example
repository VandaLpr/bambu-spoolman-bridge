# Copy to .env for local runs (npm start loads it). Never commit .env.

HA_URL=http://<home-assistant-host>:8123
# Long-lived access token (HA profile -> Security). Masked in all log output.
HA_TOKEN=
SPOOLMAN_URL=http://<spoolman-host>:7912
NOTIFY_SERVICE=notify.mobile_app_<device>
# Used for the "Open bridge" button in pending notifications (LAN only).
BRIDGE_URL=http://<bridge-host>:8080

# true (default): log every Spoolman write instead of making it. Only "false" turns writes on.
DRY_RUN=true
LOG_LEVEL=info
PORT=8080
DATA_DIR=./data

# One entry per printer. prefix = the part between "sensor." and "_print_status" in HA.
# amsLocation placeholders: {unit} = AMS number as in HA (ams_1 = 1), {n} = slot.
# Optional per printer: refreshDelayMs (default 5000) and entities, to override entity IDs, e.g.
# "entities":{"externalSpool":"sensor.x"}. Keys: status, progress, printWeight, startTime, taskName,
# activeTray, stage, externalSpool, refreshButton.
PRINTERS=[{"prefix":"<p2s_entity_prefix>","name":"P2S","amsLocation":"P2S AMS{unit} Slot {n}","externalLocation":"P2S External"},{"prefix":"<a1_entity_prefix>","name":"A1","externalLocation":"A1"}]

# Intake: empty spool weights in grams, used as spool_weight (leave empty until weighed).
# TARE_SPOOL_G is the cardboard spool, TARE_REFILL_G the reusable spool a refill goes on.
TARE_SPOOL_G=
TARE_REFILL_G=

# Tuning (defaults shown)
# JOB_START_TOLERANCE_SEC=120
# NEAREST_COLOR_MAX_DE=20
# SPOOLMAN_RETRY_MINUTES=5
# BambuStudio git ref for the colour code table (commit, tag or branch):
# BAMBU_COLOR_REF=804d93bb5de142c48c0dabedba87736ea9553206
